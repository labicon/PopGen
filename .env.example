# Copy this file to .env and fill in your API keys
# Do not commit .env to version control

# OpenAI API Key (used by litellm for openai/* models)
OPENAI_API_KEY=sk-...

# Anthropic API Key (used by litellm for anthropic/* models)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Other providers supported by litellm
# AZURE_API_KEY=...
# COHERE_API_KEY=...
# GOOGLE_API_KEY=...

# StarCraft II installation path (required for SMACv2, see docs/setup_smacv2.md)
SC2PATH=/absolute/path/to/repo/deps/StarCraftII
